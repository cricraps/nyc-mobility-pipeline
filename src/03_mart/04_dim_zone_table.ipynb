   "source": [
    "%sql\n",
    "\n",
    "-- ZONE DIMENSION TABLE --\n",
    "-- Grain: 1 row per zone, mapped to a borough\n",
    "\n",
    "CREATE OR REPLACE TABLE nyc_mobility.mart.dim_zone AS\n",
    "SELECT \n",
    "    location_id,\n",
    "    borough,\n",
    "    zone,\n",
    "    service_zone\n",
    "FROM nyc_mobility.clean.taxi_zones\n",
    "WHERE location_id IS NOT NULL;"
   ]
  }
 ],
