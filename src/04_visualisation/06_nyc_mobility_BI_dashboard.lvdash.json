{
  "datasets": [
    {
      "name": "17b6ee05",
      "displayName": "1a Borough to Borough Trip Volume and Revenue Overview",
      "queryLines": [
        "\r\n",
        "-- Question 1a: Which borough-to-borough flows carry the highest trip volume, distance, and revenue?\r\n",
        "-- Suggested chart: Heatmap | Rows: pickup_borough | Columns: dropoff_borough | Color intensity: total_trips\r\n",
        "\r\n",
        "SELECT \r\n",
        "    pz.borough AS pickup_borough,\r\n",
        "    dz.borough AS dropoff_borough,\r\n",
        "    COUNT(*) AS total_trips,\r\n",
        "    ROUND(SUM(t.trip_distance), 2) AS total_distance_miles,\r\n",
        "    ROUND(SUM(t.total_amount), 2) AS total_revenue\r\n",
        "FROM nyc_mobility.mart.fact_trip AS t\r\n",
        "JOIN nyc_mobility.mart.dim_zone AS pz \r\n",
        "    ON t.pu_location_id = pz.location_id\r\n",
        "JOIN nyc_mobility.mart.dim_zone AS dz \r\n",
        "    ON t.do_location_id = dz.location_id\r\n",
        "GROUP BY 1, 2\r\n",
        "ORDER BY total_trips DESC;"
      ]
    },
    {
      "name": "8737d7b0",
      "displayName": "1b Top Pickup Zones Ranked by Trips and Revenue Analysis",
      "queryLines": [
        "-- Question 1b: Which individual pickup zones drive the most trip volume and revenue?\r\n",
        "-- Suggested chart: Horizontal bar | X: total_trips | Y: pickup_zone (top 10) | Color: pickup_borough\r\n",
        "\r\n",
        "SELECT \r\n",
        "    pz.borough AS pickup_borough,\r\n",
        "    pz.zone AS pickup_zone,\r\n",
        "    COUNT(*) AS total_trips,\r\n",
        "    ROUND(AVG(t.trip_distance), 2) AS avg_trip_distance_miles,\r\n",
        "    ROUND(SUM(t.total_amount), 2) AS total_revenue\r\n",
        "FROM nyc_mobility.mart.fact_trip AS t\r\n",
        "JOIN nyc_mobility.mart.dim_zone AS pz \r\n",
        "    ON t.pu_location_id = pz.location_id\r\n",
        "GROUP BY pickup_borough, pickup_zone\r\n",
        "ORDER BY total_trips DESC;"
      ]
    },
    {
      "name": "6b8fd6f1",
      "displayName": "2 Trip Patterns by Hour and Day Type Analysis",
      "queryLines": [
        "-- Question 2: How do passenger volume, fare amounts, and trip durations vary across hours of the day and weekends vs. weekdays?\r\n",
        "-- Suggested chart: Line chart | X: pickup_hour | Y: total_trips | Series/Color: is_weekend\r\n",
        "\r\n",
        "SELECT \r\n",
        "    t.pickup_hour,\r\n",
        "    d.is_weekend,\r\n",
        "    COUNT(*) AS total_trips,\r\n",
        "    SUM(t.passenger_count) AS total_passengers,\r\n",
        "    ROUND(AVG(t.trip_duration_min), 2) AS avg_duration_minutes,\r\n",
        "    ROUND(AVG(t.fare_amount), 2) AS avg_fare_amount\r\n",
        "FROM nyc_mobility.mart.fact_trip AS t\r\n",
        "JOIN nyc_mobility.mart.dim_date AS d \r\n",
        "    ON t.pickup_date_hour_key = d.date_hour_key\r\n",
        "GROUP BY t.pickup_hour, d.is_weekend\r\n",
        "ORDER BY d.is_weekend, t.pickup_hour;"
      ]
    },
    {
      "name": "68b19bb3",
      "displayName": "3 Weather Impact on Trip Demand and Duration Analysis",
      "queryLines": [
        "-- Question 3: How do weather conditions (rain, snow, clear) impact trip demand, distance, and duration?\r\n",
        "-- Suggested chart: Combo (bar + line) | X: weather_condition | Bar (left Y): total_trips | Line (right Y): avg_duration_minutes\r\n",
        "\r\n",
        "SELECT \r\n",
        "    CASE \r\n",
        "        WHEN w.snowfall > 0 THEN 'Snow'\r\n",
        "        WHEN w.precipitation > 0 THEN 'Rain/Precipitation'\r\n",
        "        ELSE 'Clear/Dry'\r\n",
        "    END AS weather_condition,\r\n",
        "    ROUND(AVG(w.temperature_2m), 1) AS avg_temperature_c,\r\n",
        "    COUNT(*) AS total_trips,\r\n",
        "    ROUND(AVG(t.trip_distance), 2) AS avg_distance_miles,\r\n",
        "    ROUND(AVG(t.trip_duration_min), 2) AS avg_duration_minutes\r\n",
        "FROM nyc_mobility.mart.fact_trip AS t\r\n",
        "JOIN nyc_mobility.mart.dim_weather AS w \r\n",
        "    ON t.pickup_date_hour_key = w.date_hour_key\r\n",
        "GROUP BY weather_condition\r\n",
        "ORDER BY total_trips DESC;"
      ]
    },
    {
      "name": "c968467d",
      "displayName": "4 Traffic Patterns Amid Advisory Changes in Boroughs",
      "queryLines": [
        "-- Question 4: Do traffic advisories correlate with changes in pickup volume or trip duration within impacted boroughs?\r\n",
        "-- Suggested chart: Grouped bar | X: borough | Y: avg_duration_minutes | Color/Group: advisory_type\r\n",
        "\r\n",
        "WITH trip_advisory AS (\r\n",
        "    SELECT \r\n",
        "        t.pu_location_id,\r\n",
        "        t.do_location_id,\r\n",
        "        t.pickup_datetime,\r\n",
        "        t.dropoff_datetime,\r\n",
        "        z.borough,\r\n",
        "        t.trip_duration_min,\r\n",
        "        t.trip_distance,\r\n",
        "        t.total_amount,\r\n",
        "        a.advisory_type,\r\n",
        "        ROW_NUMBER() OVER (\r\n",
        "            PARTITION BY t.pu_location_id, t.do_location_id, t.pickup_datetime, t.dropoff_datetime\r\n",
        "            ORDER BY a.effective_from DESC\r\n",
        "        ) AS advisory_rank\r\n",
        "    FROM nyc_mobility.mart.fact_trip AS t\r\n",
        "    JOIN nyc_mobility.mart.dim_zone AS z\r\n",
        "        ON t.pu_location_id = z.location_id\r\n",
        "    LEFT JOIN nyc_mobility.mart.dim_advisory AS a\r\n",
        "        ON LOWER(TRIM(a.borough)) = LOWER(TRIM(z.borough))\r\n",
        "       AND t.pickup_datetime BETWEEN a.effective_from AND a.effective_to\r\n",
        ")\r\n",
        "SELECT \r\n",
        "    borough,\r\n",
        "    COALESCE(advisory_type, 'None') AS advisory_type,\r\n",
        "    COUNT(*) AS total_trips,\r\n",
        "    ROUND(AVG(trip_duration_min), 2) AS avg_duration_minutes,\r\n",
        "    ROUND(AVG(total_amount), 2) AS avg_total_fare\r\n",
        "FROM trip_advisory\r\n",
        "WHERE advisory_rank = 1\r\n",
        "GROUP BY borough, advisory_type\r\n",
        "ORDER BY borough, advisory_type;"
      ]
    },
    {
