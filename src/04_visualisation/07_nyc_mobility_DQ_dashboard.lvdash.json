{
  "datasets": [
    {
      "name": "32fefac7",
      "displayName": "NYC Mobility Validation Clean Layer Dataset",
      "queryLines": [
        "SELECT *\n",
        "FROM nyc_mobility.validation.clean_layer_quality;\n"
      ]
    },
    {
      "name": "a6900823",
      "displayName": "pass_checks",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS pass_checks\n",
        "FROM nyc_mobility.validation.clean_layer_quality\n",
        "WHERE status = 'PASS';"
      ]
    },
    {
      "name": "54ff32a5",
      "displayName": "warn_checks",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS warn_checks\n",
        "FROM nyc_mobility.validation.clean_layer_quality\n",
        "WHERE status = 'WARN';"
      ]
    },
    {
      "name": "b2e4bde8",
      "displayName": "fail_checks",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS fail_checks\n",
        "FROM nyc_mobility.validation.clean_layer_quality\n",
        "WHERE status = 'FAIL';"
      ]
    },
    {
      "name": "310aecd9",
      "displayName": "total_checks",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS total_checks\n",
        "FROM nyc_mobility.validation.clean_layer_quality;"
      ]
    },
    {
      "name": "137c0d09",
      "displayName": "checks_by_dataset",
      "queryLines": [
        "SELECT\n",
        "    dataset,\n",
        "    status,\n",
        "    COUNT(*) AS check_count\n",
        "FROM nyc_mobility.validation.clean_layer_quality\n",
        "GROUP BY\n",
        "    dataset,\n",
        "    status\n",
        "ORDER BY\n",
        "    dataset,\n",
        "    status;"
      ]
    },
    {
      "name": "36d71ca4",
      "displayName": "status_distribution",
      "queryLines": [
        "SELECT\n",
        "    status,\n",
        "    COUNT(*) AS checks\n",
        "FROM nyc_mobility.validation.clean_layer_quality\n",
        "GROUP BY status;"
      ]
    },
    {
      "name": "0573c0b3",
      "displayName": "dq_issues",
      "queryLines": [
        "SELECT\n",
        "    dataset,\n",
        "    `column`,\n",
        "    data_quality_check,\n",
        "    failed_rows,\n",
        "    total_rows,\n",
        "    percentage,\n",
        "    status\n",
        "FROM nyc_mobility.validation.clean_layer_quality\n",
        "WHERE status IN ('FAIL', 'WARN')\n",
        "ORDER BY\n",
        "    CASE\n",
        "        WHEN status = 'FAIL' THEN 1\n",
        "        WHEN status = 'WARN' THEN 2\n",
        "        ELSE 3\n",
        "    END,\n",
        "    percentage DESC;"
      ]
    }
  ],
