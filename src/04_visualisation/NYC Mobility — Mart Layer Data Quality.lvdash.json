{
  "datasets": [
    {
      "name": "12b783a8",
      "displayName": "NYC Mobility Validation Mart Layer Dataset",
      "queryLines": [
        "SELECT * \n",
        "FROM nyc_mobility.validation.mart_layer_quality;"
      ]
    },
    {
      "name": "c99dd465",
      "displayName": "mart_pass",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS pass_checks\n",
        "FROM nyc_mobility.validation.mart_layer_quality\n",
        "WHERE status = 'PASS';"
      ]
    },
    {
      "name": "6c1c3e0d",
      "displayName": "mart_warn",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS warn_checks\n",
        "FROM nyc_mobility.validation.mart_layer_quality\n",
        "WHERE status = 'WARN';"
      ]
    },
    {
      "name": "d2f6a50c",
      "displayName": "mart_fail",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS fail_checks\n",
        "FROM nyc_mobility.validation.mart_layer_quality\n",
        "WHERE status = 'FAIL';"
      ]
    },
    {
      "name": "75442601",
      "displayName": "mart_total_checks",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS total_checks\n",
        "FROM nyc_mobility.validation.mart_layer_quality;"
      ]
    },
    {
      "name": "2731cc80",
      "displayName": "mart_checks_by_dataset",
      "queryLines": [
        "SELECT\n",
        "    dataset,\n",
        "    status,\n",
        "    COUNT(*) AS check_count\n",
        "FROM nyc_mobility.validation.mart_layer_quality\n",
        "GROUP BY\n",
        "    dataset,\n",
        "    status\n",
        "ORDER BY\n",
        "    dataset,\n",
        "    status;"
      ]
    },
    {
      "name": "4d6cba54",
      "displayName": "mart_status_distribution",
      "queryLines": [
        "SELECT\n",
        "    status,\n",
        "    COUNT(*) AS checks\n",
        "FROM nyc_mobility.validation.mart_layer_quality\n",
        "GROUP BY status;"
      ]
    },
    {
      "name": "4ad8cc3d",
      "displayName": "mart_checks_by_type",
      "queryLines": [
        "SELECT\n",
        "    data_quality_check,\n",
        "    COUNT(*) AS check_count\n",
        "FROM nyc_mobility.validation.mart_layer_quality\n",
        "GROUP BY data_quality_check\n",
        "ORDER BY check_count DESC;"
      ]
    }
  ],
